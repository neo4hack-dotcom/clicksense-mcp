# Copy to .env (git-ignored; install-windows.bat does it). Read by clicksense and clicksense-chat.
# Variables already set in the environment win over this file.

# --- ClickHouse (use the read-only account from dev/production-account.sql) ---
CLICKSENSE_HOST=localhost
CLICKSENSE_PORT=18123
CLICKSENSE_USER=clicksense
CLICKSENSE_PASSWORD=clicksense
CLICKSENSE_DATABASE=shop
# CLICKSENSE_SECURE=true            # HTTPS (port 8443)

# --- MCP over HTTP (serve-windows.bat, the Windows service) ---
# 127.0.0.1 = this machine only. 0.0.0.0 = the network: then a token is mandatory.
CLICKSENSE_HTTP_HOST=127.0.0.1
CLICKSENSE_HTTP_PORT=3110
# Bearer tokens accepted, comma-separated (at least 24 characters). Generate: clicksense --gen-token
# install-windows.bat appends one automatically if this line is absent.
# CLICKSENSE_HTTP_TOKENS=

# --- clicksense-chat: any OpenAI-compatible LLM ---
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# CLICKSENSE_LLM_MODEL=gpt-4.1-mini
# Other providers, for example:
# OPENAI_BASE_URL=https://api.mistral.ai/v1        CLICKSENSE_LLM_MODEL=mistral-large-latest
# OPENAI_BASE_URL=https://api.groq.com/openai/v1   CLICKSENSE_LLM_MODEL=llama-3.3-70b-versatile
# OPENAI_BASE_URL=https://openrouter.ai/api/v1     CLICKSENSE_LLM_MODEL=openai/gpt-4.1-mini
# OPENAI_BASE_URL=http://localhost:11434/v1        CLICKSENSE_LLM_MODEL=gpt-oss:120b-cloud   (Ollama, no key)
# Chat against a remote ClickSense server instead of in-process:
# CLICKSENSE_MCP_TOKEN=<one of the server's CLICKSENSE_HTTP_TOKENS>

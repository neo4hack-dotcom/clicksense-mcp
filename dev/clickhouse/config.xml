<!-- Minimal single-node config for local development and tests.
     The same users.xml is mounted by docker-compose.yml. -->
<clickhouse>
    <logger>
        <level>warning</level>
        <console>0</console>
        <log>log/clickhouse-server.log</log>
        <errorlog>log/clickhouse-server.err.log</errorlog>
    </logger>
    <listen_host>127.0.0.1</listen_host>
    <http_port>18123</http_port>
    <tcp_port>19000</tcp_port>
    <users_config>users.xml</users_config>
    <max_concurrent_queries>64</max_concurrent_queries>
    <!-- Server-wide memory ceiling: the last line of defence for the host. -->
    <max_server_memory_usage_to_ram_ratio>0.5</max_server_memory_usage_to_ram_ratio>
    <query_cache>
        <max_size_in_bytes>268435456</max_size_in_bytes>
        <max_entries>1024</max_entries>
        <max_entry_size_in_bytes>4194304</max_entry_size_in_bytes>
        <max_entry_size_in_rows>100000</max_entry_size_in_rows>
    </query_cache>
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <flush_interval_milliseconds>2000</flush_interval_milliseconds>
    </query_log>
</clickhouse>
